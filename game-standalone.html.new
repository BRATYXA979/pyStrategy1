in":"ice","poly":[[0.022,18.002],[0.496,17.99],[1.001,18.009],[1.508,17.998],[1.995,17.992],[2.019,18.49],[1.986,19.007],[2.019,19.495],[1.995,19.992],[1.508,19.998],[1.001,20.009],[0.496,19.99],[0.022,20.002],[0.008,19.505],[0.03,19.001],[-0.004,18.497]],"label":[1.0,19.0]},{"id":"B10","row":9,"col":1,"terrain":"ice","poly":[[1.995,17.992],[2.496,17.99],[3.001,18.009],[3.508,17.998],[3.995,17.992],[4.019,18.49],[3.986,19.007],[4.019,19.495],[3.995,19.992],[3.508,19.998],[3.001,20.009],[2.496,19.99],[1.995,19.992],[2.019,19.495],[1.986,19.007],[2.019,18.49]],"label":[3.0,19.0]},{"id":"C10","row":9,"col":2,"terrain":"ice","poly":[[3.995,17.992],[4.496,17.99],[5.001,18.009],[5.508,17.998],[5.995,17.992],[6.019,18.49],[5.986,19.007],[6.019,19.495],[5.995,19.992],[5.508,19.998],[5.001,20.009],[4.496,19.99],[3.995,19.992],[4.019,19.495],[3.986,19.007],[4.019,18.49]],"label":[5.0,19.0]},{"id":"D10","row":9,"col":3,"terrain":"ice","poly":[[5.995,17.992],[6.496,17.99],[7.001,18.009],[7.508,17.998],[7.995,17.992],[8.019,18.49],[7.986,19.007],[8.019,19.495],[7.995,19.992],[7.508,19.998],[7.001,20.009],[6.496,19.99],[5.995,19.992],[6.019,19.495],[5.986,19.007],[6.019,18.49]],"label":[7.0,19.0]},{"id":"E10","row":9,"col":4,"terrain":"ice","poly":[[7.995,17.992],[8.496,17.99],[9.001,18.009],[9.508,17.998],[9.995,17.992],[10.019,18.49],[9.986,19.007],[10.019,19.495],[9.995,19.992],[9.508,19.998],[9.001,20.009],[8.496,19.99],[7.995,19.992],[8.019,19.495],[7.986,19.007],[8.019,18.49]],"label":[9.0,19.0]},{"id":"F10","row":9,"col":5,"terrain":"water","poly":[[9.995,17.992],[10.496,17.99],[11.001,18.009],[11.508,17.998],[11.995,17.992],[12.019,18.49],[11.986,19.007],[12.019,19.495],[11.995,19.992],[11.508,19.998],[11.001,20.009],[10.496,19.99],[9.995,19.992],[10.019,19.495],[9.986,19.007],[10.019,18.49]],"label":[11.0,19.0]},{"id":"G10","row":9,"col":6,"terrain":"ice","poly":[[11.995,17.992],[12.496,17.99],[13.001,18.009],[13.508,17.998],[13.995,17.992],[14.019,18.49],[13.986,19.007],[14.019,19.495],[13.995,19.992],[13.508,19.998],[13.001,20.009],[12.496,19.99],[11.995,19.992],[12.019,19.495],[11.986,19.007],[12.019,18.49]],"label":[13.0,19.0]},{"id":"H10","row":9,"col":7,"terrain":"ice","poly":[[13.995,17.992],[14.496,17.99],[15.001,18.009],[15.508,17.998],[15.995,17.992],[16.019,18.49],[15.986,19.007],[16.019,19.495],[15.995,19.992],[15.508,19.998],[15.001,20.009],[14.496,19.99],[13.995,19.992],[14.019,19.495],[13.986,19.007],[14.019,18.49]],"label":[15.0,19.0]},{"id":"I10","row":9,"col":8,"terrain":"ice","poly":[[15.995,17.992],[16.496,17.99],[17.001,18.009],[17.508,17.998],[17.995,17.992],[18.019,18.49],[17.986,19.007],[18.019,19.495],[17.995,19.992],[17.508,19.998],[17.001,20.009],[16.496,19.99],[15.995,19.992],[16.019,19.495],[15.986,19.007],[16.019,18.49]],"label":[17.0,19.0]},{"id":"J10","row":9,"col":9,"terrain":"ice","poly":[[17.995,17.992],[18.496,17.99],[19.001,18.009],[19.508,17.998],[19.995,17.992],[20.019,18.49],[19.986,19.007],[20.019,19.495],[19.995,19.992],[19.508,19.998],[19.001,20.009],[18.496,19.99],[17.995,19.992],[18.019,19.495],[17.986,19.007],[18.019,18.49]],"label":[19.0,19.0]}]};
/* ============================================================================ */

const COLS = MAP_DATA.cols, ROWS = MAP_DATA.rows;
const LETTERS = "ABCDEFGHIJ";

// Типы местности: название, иконка, цвет, стоимость входа (null = непроходимо)
const TERRAIN = {
    plain:    { name:"Равнина", icon:"",  color:"#4a7a50", cost:1 },
    forest:   { name:"Лес",     icon:"",  color:"#315c3d", cost:2 },
    hills:    { name:"Холмы",   icon:"",  color:"#8a9358", cost:2 },
    desert:   { name:"Пустошь", icon:"",  color:"#9b8a5e", cost:1 },
    mountain: { name:"Горы",    icon:"⛰", color:"#77604d", cost:null },
    water:    { name:"Вода",    icon:"≈", color:"#2e5f8a", cost:null },
    ice:      { name:"Полюс",   icon:"❄", color:"#c9dde8", cost:1 },
};

/** zones[r][c] = { id, row, col, terrain, poly, label, unit, el } */
const zones = [];
for (let r = 0; r < ROWS; r++) zones.push(new Array(COLS).fill(null));
for (const zd of MAP_DATA.zones) {
    const z = { ...zd, unit: null };
    zones[z.row][z.col] = z;
}

/* ================= Юниты ================= */
const UNIT_TYPES = {
    scout:  { name:"Разведчик", glyph:"🐎", moves: 3 },
    knight: { name:"Рыцарь",    glyph:"⚔", moves: 2 },
};
function makeUnit(owner, type, zoneRef) {
    const u = { owner, type, zone: zoneRef, movesLeft: UNIT_TYPES[type].moves };
    zoneRef.unit = u;
    return u;
}
makeUnit(1, "scout", zones[8][1]); // B9

/* ================= Рендер SVG карты ================= */
const NS = "http://www.w3.org/2000/svg";
const svg = document.getElementById("mapSvg");
const layerZones = document.createElementNS(NS, "g");
const layerLabels = document.createElementNS(NS, "g");
const layerUnits = document.createElementNS(NS, "g");
svg.appendChild(layerZones); svg.appendChild(layerLabels); svg.appendChild(layerUnits);

for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
        const z = zones[r][c];
        const t = TERRAIN[z.terrain];

        const poly = document.createElementNS(NS, "polygon");
        poly.setAttribute("points", z.poly.map(p => p.join(",")).join(" "));
        poly.setAttribute("class", "zone");
        poly.style.fill = t.color;
        poly.addEventListener("click", () => onZoneClick(z));
        layerZones.appendChild(poly);
        z.el = poly;

        // подпись координаты + иконка местности
        const [lx, ly] = z.label;
        if (t.icon) {
            const ti = document.createElementNS(NS, "text");
            ti.setAttribute("x", lx); ti.setAttribute("y", ly - 0.02);
            ti.setAttribute("class", "terrain-icon");
            ti.textContent = t.icon;
            layerLabels.appendChild(ti);
        }
        const lbl = document.createElementNS(NS, "text");
        lbl.setAttribute("x", lx); lbl.setAttribute("y", ly + (t.icon ? 0.3 : 0.08));
        lbl.setAttribute("class", "zone-label");
        lbl.textContent = z.id;
        layerLabels.appendChild(lbl);
    }
}

function renderUnits() {
    while (layerUnits.firstChild) layerUnits.removeChild(layerUnits.firstChild);
    for (const row of zones) for (const z of row) {
        if (!z.unit) continue;
        const g = document.createElementNS(NS, "g");
        g.setAttribute("class", `unit-g${z.unit.owner}`);
        const [cx, cy] = z.label;
        const ring = document.createElementNS(NS, "circle");
        ring.setAttribute("cx", cx); ring.setAttribute("cy", cy - 0.05);
        ring.setAttribute("r", 0.3);
        ring.setAttribute("class", "unit-ring");
        const gl = document.createElementNS(NS, "text");
        gl.setAttribute("x", cx); gl.setAttribute("y", cy + 0.12);
        gl.setAttribute("class", "unit-glyph");
        gl.textContent = UNIT_TYPES[z.unit.type].glyph;
        g.appendChild(ring); g.appendChild(gl);
        layerUnits.appendChild(g);
    }
    document.getElementById("unitsP1").textContent = "Юниты: " + countUnits(1) + "/24";
    document.getElementById("unitsP2").textContent = "Юниты: " + countUnits(2) + "/24";
}
function countUnits(p) { let n = 0; for (const row of zones) for (const z of row) if (z.unit && z.unit.owner === p) n++; return n; }

/* ================= Выбор зоны и подсветка ================= */
let selected = null;
let reachable = new Map(); // zone -> стоимость пути (BFS/Dijkstra по очкам движения)

function clearHighlights() {
    svg.querySelectorAll(".selected,.move-target,.attack-target").forEach(e =>
        e.classList.remove("selected", "move-target", "attack-target"));
    while (moveDotsLayer.firstChild) moveDotsLayer.removeChild(moveDotsLayer.firstChild);
    reachable.clear();
}
const moveDotsLayer = document.createElementNS(NS, "g");
svg.appendChild(moveDotsLayer);

// все достижимые зоны за movesLeft очков: горы/вода нельзя, сквозь врага нельзя
function computeReachable(unit) {
    const budget = unit.movesLeft;
    const dist = new Map([[unit.zone, 0]]);
    const q = [unit.zone];
    while (q.length) {
        const cur = q.shift();
        const d = dist.get(cur);
        if (d >= budget) continue;
        for (let dr = -1; dr <= 1; dr++) for (let dc = -1; dc <= 1; dc++) {
            if (!dr && !dc) continue;
            const r = cur.row + dr, c = cur.col + dc;
            if (r < 0 || c < 0 || r >= ROWS || c >= COLS) continue;
            const nz = zones[r][c];
            const t = TERRAIN[nz.terrain];
            if (t.cost === null) continue;
            if (nz.unit && nz.unit.owner !== unit.owner) continue;
            const nd = d + Math.max(1, t.cost);
            if (nd <= budget && (!dist.has(nz) || nd < dist.get(nz))) {
                dist.set(nz, nd); q.push(nz);
            }
        }
    }
    dist.delete(unit.zone);
    return dist;
}

function onZoneClick(z) {
    // приказ двигаться — клик по подсвеченной зоне
    if (selected && selected.unit && selected.unit.owner === currentPlayer && reachable.has(z)) {
        moveUnit(selected.unit, z);
        selected.unit.movesLeft -= reachable.get(z);
        clearHighlights();
        selected = z; z.el.classList.add("selected");
        if (selected.unit.movesLeft > 0) {
            reachable = computeReachable(selected.unit);
            paintReachable();
        }
        updateInfo(z);
        return;
    }
    clearHighlights();
    if (selected === z) { selected = null; updateInfo(null); return; }
    selected = z;
    z.el.classList.add("selected");
    if (z.unit && z.unit.owner === currentPlayer) {
        reachable = computeReachable(z.unit);
        paintReachable();
    }
    updateInfo(z);
}
function paintReachable() {
    for (const rz of reachable.keys()) {
        rz.el.classList.add("move-target");
        const [cx, cy] = rz.label;
        const dot = document.createElementNS(NS, "circle");
        dot.setAttribute("cx", cx); dot.setAttribute("cy", cy + 0.28);
        dot.setAttribute("r", 0.07);
        dot.setAttribute("class", "unit-move-dot");
        moveDotsLayer.appendChild(dot);
    }
}

function moveUnit(unit, dest) {
    unit.zone.unit = null;
    dest.unit = unit;
    unit.zone = dest;
    renderUnits();
}

/* ================= Панель информации ================= */
function updateInfo(z) {
    const bar = document.getElementById("infoBar");
    if (!z) { bar.textContent = "Выберите провинцию на карте."; return; }
    const t = TERRAIN[z.terrain];
    let html = `<span class="k">Провинция:</span><span class="v">${z.id}</span>` +
        `<span class="k">Местность:</span><span class="v">${t.icon} ${t.name}</span>` +
        `<span class="k">Стоимость входа:</span><span class="v">${t.cost === null ? "непроходимо" : t.cost}</span>`;
    html += z.unit
        ? `<span class="k">Юнит:</span><span class="v">${UNIT_TYPES[z.unit.type].glyph} ${UNIT_TYPES[z.unit.type].name} · Игрок ${z.unit.owner} (движение: ${z.unit.movesLeft})</span>`
        : `<span class="k">Юнит:</span><span class="v">—</span>`;
    bar.innerHTML = html;
}

/* ================= Ходы игроков ================= */
let currentPlayer = 1, turn = 1;
document.getElementById("endTurnBtn").addEventListener("click", endTurn);
document.addEventListener("keydown", e => {
    if (e.code === "Space") { e.preventDefault(); endTurn(); }
    if (e.key === "Escape") { clearHighlights(); selected = null; updateInfo(null); }
});
function endTurn() {
    currentPlayer = currentPlayer === 1 ? 2 : 1;
    if (currentPlayer === 1) turn++;
    for (const row of zones) for (const z of row) if (z.unit) z.unit.movesLeft = UNIT_TYPES[z.unit.type].moves;
    document.getElementById("turnNum").textContent = turn;
    document.getElementById("cardP1").classList.toggle("active", currentPlayer === 1);
    document.getElementById("cardP2").classList.toggle("active", currentPlayer === 2);
    clearHighlights(); selected = null;
    updateInfo(null);
}

renderUnits();
updateInfo(zones[8][1]);
</script>
</body>
</html>
